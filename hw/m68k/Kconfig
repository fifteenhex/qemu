config AMIGA
    bool
    default y
    depends on M68K
    select PTIMER
    select SPLIT_IRQ
    select OR_IRQ
    select PCNET_COMMON
    select WD33C93
    select IDE_GAYLE
    select BITBANG_I2C
    select AT24C
    select PCI
    imply PCI_DEVICES
    # device-tree direct boot of an MMU-less 68000 kernel (a500): a
    # goldfish console the DT kernel's drivers bind to, and libfdt to
    # synthesise the blob handed over in d7.
    select GOLDFISH_TTY
    select DEVICE_TREE

